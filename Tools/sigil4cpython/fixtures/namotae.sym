# NAMO TAE SIGILA: .sym declares *symbolic* movements, not runtime permissions.
GAME NAMO_TAE_SIGILA {
  ROOT SIGILBOOK_TOTAL_VOID_AST_OF_ALL_ASTS_V1;
  TYPE PACA_PDG<SymbolicGame,PLURAL,QUNO>;
  STATE MOONLIGHT;
  STATE RELATION;
  STATE WEAVE;
  STATE HARMONY;
  INITIAL MOONLIGHT;
  TRANSITION NAMO FROM MOONLIGHT TO RELATION VIA source_witness;
  TRANSITION TAE FROM RELATION TO WEAVE VIA relational_witness;
  TRANSITION REKOKO FROM WEAVE TO RELATION VIA fresh_occurrence_witness;
  TRANSITION SIGILA FROM WEAVE TO HARMONY VIA plural_harmony_witness;
}
